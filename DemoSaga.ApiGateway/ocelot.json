        {
          "Host": "localhost",
          "Port": 5239
        }
      ],
      "UpstreamPathTemplate": "/api/product/{id}",
      "UpstreamHttpMethod": [ "GET" ],
      "FileCacheOptions": {
        "Region": "default",
        "TtlSeconds": 60
      }

    },
    //Get orders

    {
      "DownstreamPathTemplate": "/api/order",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5018
        }
      ],
      "UpstreamPathTemplate": "/api/order",
      "UpstreamHttpMethod": [ "GET" ],
      "FileCacheOptions": {
        "Region": "default",
        "TtlSeconds": 60
      }
    },
    // Post order
    {
      "DownstreamPathTemplate": "/api/order",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5018
        }
      ],
      "UpstreamPathTemplate": "/api/order",
